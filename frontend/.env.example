# ---- Frontend (Vite) ----
# Only VITE_-prefixed vars are exposed to the browser. Copy this to
# `frontend/.env` and fill in the value.

# "Sign in with Google" — the SAME OAuth client ID used by the backend
# (GOOGLE_CLIENT_ID). From Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID (Web application).
VITE_GOOGLE_CLIENT_ID=
