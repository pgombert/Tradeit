# ---- Backend ----
NODE_ENV=development
PORT=4002

DATABASE_URL=postgresql://tradeit:tradeit_dev@localhost:5434/tradeit
REDIS_URL=redis://localhost:6381

# Auth — single user. Only this address may hold an account or sign in.
ALLOWED_EMAIL=pete@goodwellpartners.com
JWT_SECRET=change-me-locally
JWT_REFRESH_SECRET=change-me-locally-too

# "Sign in with Google" — the OAuth client ID from Google Cloud Console
# (APIs & Services → Credentials → OAuth client ID → Web application).
# The SAME value goes in the frontend as VITE_GOOGLE_CLIENT_ID (see frontend/.env.example).
GOOGLE_CLIENT_ID=

FRONTEND_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002

# ---- Data sources ----
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_ID=

# Free key: https://finnhub.io/register  (earnings calendar collector)
FINHUB_APIKEY=

# Schwab Trader API — register at https://developer.schwab.com
# Read scopes only. The app never calls the trading endpoints.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182/callback

# Gmail newsletter collector — the dedicated inbox subscribed to the §3 letters.
# OAuth client from console.cloud.google.com with the gmail.readonly scope; the
# refresh token is minted once (see docs/SETUP.md) and stored as a secret.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Risk limits (dollars) ----
STARTING_CAPITAL=100000
MAX_DRAWDOWN=30000

# ---- Optional ----
ANTHROPIC_API_KEY=
SENTRY_DSN=
